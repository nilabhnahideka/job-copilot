# Copy this file to .env and fill in your values. .env is never committed to Git.

# "development" on your computer, "production" on Render (turns on safety checks)
ENVIRONMENT=development

# AI provider: "gemini" (free tier, no card needed) or "openai" (paid)
LLM_PROVIDER=gemini

# Gemini: create a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any model marked "Free of charge" at https://ai.google.dev/gemini-api/docs/pricing
GEMINI_MODEL=gemini-3.8-flash

# OpenAI (only if LLM_PROVIDER=openai): https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Signs login tokens. Required in production; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Local development: a SQLite file (nothing to install)
DATABASE_URL=sqlite:///./data/copilot.db
CHECKPOINT_DB_PATH=./data/checkpoints.db
# Production: a Postgres URL, e.g. from Neon (checkpoints go in the same database)
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

CORS_ORIGINS=http://localhost:3000

# Optional: tracing with LangSmith (free tier) - every graph run shows up as a trace
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=job-copilot
